{
  "name": "@jason-os/identity-manager",
  "version": "0.1.0",
  "description": "Identity management: core persona, burner personas, shadow personas, zero-trace switching",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "import": "./dist/index.js", "types": "./dist/index.d.ts" } },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@jason-os/shared": "workspace:*",
    "@jason-os/privacy-kernel": "workspace:*",
    "@jason-os/session-manager": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "vitest": "^1.1.0",
    "@types/node": "^20.10.0"
  }
}
